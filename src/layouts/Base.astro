---
import '../styles/global.css';
import {brand,domain,ga4Id} from '../data/cities';
interface Props {title:string;description:string;path:string;jsonld?:object[];fabHref?:string}
const {title,description,path,jsonld=[],fabHref='#deal-form'}=Astro.props;
const canonical=`https://${domain}${path}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title}</title>
<meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
<meta property="og:type" content="website"/>
<meta property="og:title" content={title}/>
<meta property="og:description" content={description}/>
<meta property="og:url" content={canonical}/>
<meta property="og:site_name" content={brand}/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<meta name="theme-color" content="#154e58"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet"/>{(jsonld.length ? jsonld : [{"@context":"https://schema.org","@type":"WebPage",name:title,url:canonical,description}]).map(obj=>
<script is:inline type="application/ld+json" set:html={JSON.stringify(obj)}/>)}
{ga4Id && <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>}
{ga4Id && <script is:inline define:vars={{ga4Id}}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga4Id);</script>}
{import.meta.env.BASE_URL !== '/' && <meta name="robots" content="noindex,nofollow"/>}
</head>
<body>
<slot/>
<a href={fabHref} class="fab-deal" aria-label="Submit a project, jump to the form">
<span class="fab-deal-ico" aria-hidden="true">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6">
</path>
</svg>
</span>
<span class="fab-deal-text">
<span class="fab-deal-text-k">Fix &amp; Flip Funding</span>
<span class="fab-deal-text-v">Submit Project</span>
</span>
</a>
<script is:inline>
/* Keep the form and bottom-of-page content clear of the floating CTA. */
(() => {
  const cta = document.querySelector('.fab-deal');
  if (!cta) return;
  const zones = [...document.querySelectorAll('#deal-form, .final-cta, .site-footer')];
  const sync = () => {
    const overlaps = zones.some(zone => {
      const r = zone.getBoundingClientRect();
      return r.bottom > 0 && r.top < window.innerHeight && r.right > 0 && r.left < window.innerWidth;
    });
    cta.style.display = overlaps ? 'none' : '';
  };
  sync();
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(sync, { threshold: 0 });
    zones.forEach(zone => observer.observe(zone));
  }
  window.addEventListener('scroll', sync, { passive: true });
  window.addEventListener('resize', sync);
})();
</script>
<script is:inline src="https://api.airchatty.com/js/external-tracking.js" data-tracking-id="tk_61d238e145314251999b74fdd5c953cf" defer>
</script>
</body>
</html>
